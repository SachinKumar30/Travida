# Required at runtime — used by the Express app locally AND by the Vercel
# serverless function (set these as Vercel Environment Variables too).
JWT_SECRET=change-this-to-a-long-random-string
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local dev only — port for the standalone Express server (not used on Vercel).
PORT=4000

# Used only by `node scripts/seed.mjs` to create the first admin account.
# Not needed at runtime after that — safe to remove from Vercel once seeded.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
